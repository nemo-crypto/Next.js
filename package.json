{
    "name": "website",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "APP_ENV=dev next dev -p 9000",
        "build:qa": "APP_ENV=qa next build",
        "build:prod": "APP_ENV=prod next build",
        "start": "next start -p 5000",
        "lint": "eslint app src proxy.ts next.config.js playwright.config.ts scripts tests",
        "pm2:start": "pnpm install --frozen-lockfile && pm2 delete ./pm2.config.js && pm2 start ./pm2.config.js",
        "build": "next build",
        "type-check": "tsc --noEmit",
        "test": "node --test tests/*.test.cjs",
        "check": "pnpm lint && pnpm type-check && pnpm test",
        "smoke": "node scripts/smoke.mjs",
        "test:e2e": "playwright test",
        "dev:demo": "SSR_DEMOS_ENABLED=true APP_ENV=dev next dev -p 9000",
        "build:e2e": "API_URL=http://127.0.0.1:9099/ API_FUTURES=http://127.0.0.1:9099/ STATIC_URL= NEXT_PUBLIC_GA_ID= NEXT_PUBLIC_SITE_URL=https://ssr.example.test NEXT_PUBLIC_INDEXABLE=true SSR_DEMOS_ENABLED=true APP_ENV=prod next build",
        "verify:e2e": "pnpm build:e2e && pnpm test:e2e && pnpm test:demo-disabled",
        "audit:prod": "pnpm audit --prod --audit-level=moderate",
        "test:demo-disabled": "node scripts/check-demo-disabled.mjs"
    },
    "dependencies": {
        "axios": "^1.21.1",
        "bignumber.js": "^11.1.5",
        "date-fns": "^4.4.0",
        "echarts": "^6.1.0",
        "html-react-parser": "^6.1.9",
        "i18next": "27.1.1",
        "js-cookie": "^3.0.8",
        "mobx": "^7.1.7",
        "mobx-react-lite": "5.1.3",
        "next": "16.4.6",
        "pako": "^3.0.3",
        "query-string": "^10.0.0",
        "rc-tooltip": "^6.4.0",
        "react": "19.3.1",
        "react-day-picker": "10.0.2",
        "react-dom": "19.3.1",
        "react-i18next": "18.0.1",
        "react-sparklines": "^1.7.0",
        "sanitize-html": "2.18.2",
        "server-only": "0.0.1",
        "swiper": "^14.4.0"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.14.0",
        "@playwright/test": "^1.65.1",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/sanitize-html": "2.16.2",
        "classnames": "^2.5.1",
        "eslint": "^9.39.5",
        "eslint-config-next": "16.4.6",
        "sass": "^1.108.2",
        "typescript": "^6.0.3"
    },
    "engines": {
        "node": ">=24.14.0"
    },
    "packageManager": "pnpm@10.32.0"
}
