{
    "name": "website",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "APP_ENV=dev next dev -p 9000",
        "build:qa": "APP_ENV=qa next build",
        "build:prod": "APP_ENV=prod next build",
        "start": "next start -p 5000",
        "lint": "eslint app src proxy.ts next.config.js tests",
        "pm2:start": "yarn && pm2 delete ./pm2.config.js && pm2 start ./pm2.config.js",
        "build": "next build",
        "type-check": "tsc --noEmit",
        "test": "node --test tests/*.test.cjs",
        "check": "yarn lint && yarn type-check && yarn test",
        "smoke": "node scripts/smoke.mjs"
    },
    "dependencies": {
        "axios": "^1.2.0",
        "bignumber.js": "^9.1.2",
        "date-fns": "^2.30.0",
        "echarts": "^5.4.3",
        "js-cookie": "^3.0.1",
        "next": "16.4.5",
        "next-translate": "3.2.0",
        "query-string": "^8.1.0",
        "rc-tooltip": "^6.1.2",
        "react": "19.3.1",
        "react-day-picker": "9.14.0",
        "react-dom": "19.3.1",
        "react-sparklines": "^1.7.0",
        "swiper": "^6.7.5",
        "html-react-parser": "^5.2.0",
        "server-only": "0.0.1",
        "mobx": "^6.15.0",
        "mobx-react-lite": "4.1.1"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "classnames": "^2.3.2",
        "eslint": "^9.39.0",
        "eslint-config-next": "16.4.5",
        "sass": "^1.56.1",
        "typescript": "^5.9.3"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "packageManager": "yarn@1.22.22"
}
