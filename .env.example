# 公开站点信息；不要在 NEXT_PUBLIC_* 中放密钥。
NEXT_PUBLIC_SITE_URL=https://www.example.com
NEXT_PUBLIC_SITE_NAME=DemoExchange
# 只有正式域名及业务内容验收完成后才开启；qa 永远不索引。
NEXT_PUBLIC_INDEXABLE=false
# 可选，仅填写已上线的动态页面路径，逗号分隔。
SITEMAP_PATHS=
NEXT_PUBLIC_GA_ID=
# 业务地址通常以 / 结尾；未配置时公开 SSR 数据返回空状态，不调用虚构接口。
API_URL=
API_FUTURES=
WEBSITE_URL=
WEBSOCKET_URL=
STATIC_URL=
COOKIES_DOMIAN=
LANGUAGE_PARAM_NAME=language
# 本地 SSR/SEO/UX 实验页 /demos/ssr；正式环境默认关闭，且永不收录。
SSR_DEMOS_ENABLED=false
